# Copie para .env: cp .env.example .env
# ---- Aplicacao ----
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost      # docker-compose sobrescreve para "db"
POSTGRES_PORT=5432           # porta usada pela app (dentro da rede do compose)
POSTGRES_HOST_PORT=5433      # porta publicada no host (evita conflito com um Postgres local)
POSTGRES_USER=dim
POSTGRES_PASSWORD=dim_secret
POSTGRES_DB=dim_db
DB_ECHO=false

# ---- Ingestao ----
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Embeddings / LLM (Fase 2) ----
# openai | huggingface
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# 1536 -> text-embedding-3-small | 384 -> all-MiniLM-L6-v2
EMBEDDING_DIM=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
OPENAI_API_KEY=

# ---- Recuperacao ----
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_DISTANCE=0.6
