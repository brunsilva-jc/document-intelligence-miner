# Copie para .env: cp .env.example .env
# ---- Aplicacao ----
# local = permissivo (docs abertos, schema via create_all, sem chave exigida).
# staging/production = a aplicacao RECUSA subir sem API_KEY, OPENAI_API_KEY e
# uma POSTGRES_PASSWORD diferente da de desenvolvimento.
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8000

# ---- Seguranca ----
# Exigida no header X-API-Key em todas as rotas /documents (o /health fica
# aberto para o monitor externo). Vazia = checagem desligada, so em local.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Origens liberadas no CORS, separadas por virgula. Vazio = nenhuma, que e o
# certo para uma API consumida por servidor. Ex.: ["https://app.exemplo.com"]
CORS_ALLOW_ORIGINS=[]

# ---- Limites de uso ----
# A chave diz QUEM pode chamar; estes tetos dizem QUANTO. Sem eles, uma chave
# vazada (ou uma demo publica) e um laco de /ask gastando a conta do provedor.
RATE_LIMIT_ENABLED=true
# Janela curta, por cliente: contem rajada.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Teto das rotas que gastam tokens (/upload e /ask). Global, porque a fatura
# que se protege e uma so. 86400s = 24h.
RATE_LIMIT_METERED_DAILY=200
RATE_LIMIT_METERED_WINDOW_SECONDS=86400

# ---- Producao ----
# Nome da rede Docker externa onde vive o proxy reverso que termina o TLS.
# Usado so pelo docker-compose.prod.yml; veja docs/DEPLOY.md.
EDGE_NETWORK=edge

# ---- PostgreSQL ----
POSTGRES_HOST=localhost      # docker-compose sobrescreve para "db"
POSTGRES_PORT=5432           # porta usada pela app (dentro da rede do compose)
POSTGRES_HOST_PORT=5433      # porta publicada no host (evita conflito com um Postgres local)
POSTGRES_USER=dim
# `dim_secret` e a senha de desenvolvimento e esta publicada no repositorio:
# fora de local a aplicacao recusa subir com ela.
POSTGRES_PASSWORD=dim_secret
POSTGRES_DB=dim_db
DB_ECHO=false

# ---- Ingestao ----
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Embeddings / LLM (Fase 2) ----
# openai | huggingface
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# 1536 -> text-embedding-3-small | 384 -> all-MiniLM-L6-v2
EMBEDDING_DIM=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
OPENAI_API_KEY=

# ---- Recuperacao ----
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_DISTANCE=0.6
