# Copie para .env: cp .env.example .env
# ---- Aplicacao ----
# local = permissivo (docs abertos, schema via create_all, sem chave exigida).
# staging/production = a aplicacao RECUSA subir sem API_KEY, OPENAI_API_KEY e
# uma POSTGRES_PASSWORD diferente da de desenvolvimento.
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8000

# ---- Seguranca ----
# Exigida no header X-API-Key em todas as rotas /documents (o /health fica
# aberto para o monitor externo). Vazia = checagem desligada, so em local.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Origens liberadas no CORS, separadas por virgula. Vazio = nenhuma, que e o
# certo para uma API consumida por servidor. Ex.: ["https://app.exemplo.com"]
CORS_ALLOW_ORIGINS=[]

# ---- Limites de uso ----
# A chave diz QUEM pode chamar; estes tetos dizem QUANTO. Sem eles, uma chave
# vazada (ou uma demo publica) e um laco de /ask gastando a conta do provedor.
RATE_LIMIT_ENABLED=true
# Janela curta, por cliente: contem rajada.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Teto das rotas que gastam tokens (/upload e /ask). Global, porque a fatura
# que se protege e uma so. 86400s = 24h.
RATE_LIMIT_METERED_DAILY=50
RATE_LIMIT_METERED_WINDOW_SECONDS=86400

# ---- Observabilidade ----
# Erro agregado. Vazio = desligado: nada e enviado para lugar nenhum, e a
# aplicacao segue logando igual. O mesmo DSN serve um GlitchTip auto-hospedado,
# que fala o protocolo do Sentry.
SENTRY_DSN=
# Fracao de requisicoes com tracing. 0.0 = so erros, que e o que uma demo pede.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Fracao do teto diario (RATE_LIMIT_METERED_DAILY) a partir da qual o consumo
# vira alerta. O teto em si ja e tarde: quando ele bate, a demo passou o dia
# sendo usada por alguem e so agora alguem fica sabendo.
COST_ALERT_THRESHOLD=0.8

# ---- Retencao do acervo ----
# Nada aqui protege a fatura: protege quem enviou o arquivo. Numa demo publica
# o documento de um estranho e dado de terceiro, e guarda-lo para sempre porque
# ninguem escreveu a linha que o apaga tambem e uma decisao.
RETENTION_ENABLED=true
# Idade maxima de um documento, em dias. Vencido, sai com seus chunks.
RETENTION_MAX_AGE_DAYS=7
# Teto de documentos no acervo: os mais antigos saem primeiro. Pega o que a
# idade nao pega — uma enxurrada inteira dentro da mesma janela.
RETENTION_MAX_DOCUMENTS=100
# Intervalo entre varreduras. A primeira acontece no boot. 3600s = 1h.
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# ---- Producao ----
# Nome da rede Docker externa onde vive o proxy reverso que termina o TLS.
# Usado so pelo docker-compose.prod.yml; veja docs/DEPLOY.md.
EDGE_NETWORK=edge

# ---- PostgreSQL ----
POSTGRES_HOST=localhost      # docker-compose sobrescreve para "db"
POSTGRES_PORT=5432           # porta usada pela app (dentro da rede do compose)
POSTGRES_HOST_PORT=5433      # porta publicada no host (evita conflito com um Postgres local)
POSTGRES_USER=dim
# `dim_secret` e a senha de desenvolvimento e esta publicada no repositorio:
# fora de local a aplicacao recusa subir com ela.
POSTGRES_PASSWORD=dim_secret
POSTGRES_DB=dim_db
DB_ECHO=false

# ---- Ingestao ----
# O que de fato limita o gasto: o /upload embeda o documento inteiro.
MAX_UPLOAD_SIZE_MB=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Embeddings / LLM (Fase 2) ----
# openai | huggingface
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# 1536 -> text-embedding-3-small | 384 -> all-MiniLM-L6-v2
EMBEDDING_DIM=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
OPENAI_API_KEY=

# ---- Recuperacao ----
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_DISTANCE=0.6
